# The Savoury Lab — Hydrogen storefront environment

# Session (required)
SESSION_SECRET=replace-with-a-long-random-string

# --- Before you have a Shopify account (demo catalogue) ---
# Uses Shopify's public mock.shop so the UI works without a merchant store.
PUBLIC_STORE_DOMAIN=mock.shop
PUBLIC_STOREFRONT_API_TOKEN=public
PUBLIC_STOREFRONT_ID=mock
PUBLIC_CHECKOUT_DOMAIN=checkout.shopify.com

# --- After Shopify signup (replace mock values) ---
# npx shopify hydrogen link
# npx shopify hydrogen env pull
# PUBLIC_STORE_DOMAIN=your-store.myshopify.com
# PUBLIC_STOREFRONT_API_TOKEN=
# PUBLIC_STOREFRONT_ID=
# PUBLIC_CHECKOUT_DOMAIN=checkout.shopify.com

# Customer Account API (optional until /account is used; not available on mock.shop)
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# Optional cinematic hero background (MP4 on Shopify Files / CDN)
PUBLIC_HERO_VIDEO_URL=

# Analytics (optional)
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=

# Form webhooks — POST JSON to Zapier / Make / Resend inbound / custom inbox
# Without these, forms still return success but only log server-side.
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
WHOLESALE_WEBHOOK_URL=
